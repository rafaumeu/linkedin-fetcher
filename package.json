{
  "name": "linkedinfetcher",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "author": "Rafael Dias Zendron <rafael.zendron22@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --config ./vitest.config.ts",
    "test:coverage": "vitest run --coverage --config ./vitest.config.ts",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:watch": "vitest -c vitest.e2e.config.ts",
    "test:e2e:coverage": "vitest run -c vitest.e2e.config.ts --coverage",
    "test:mutation": "stryker run",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "description": "",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rafaumeu"
  },
  "dependencies": {
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "dotenv": "^16.4.1",
    "drizzle-orm": "^0.39.3",
    "fastify": "^4.26.0",
    "postgres": "^3.4.3",
    "puppeteer": "^22.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.2.2",
    "@vitest/ui": "^3.0.7",
    "drizzle-kit": "^0.30.4",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^1.2.2"
  }
}